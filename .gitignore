# ---------------------------------------------------------------------------
# .NET / backend
# ---------------------------------------------------------------------------
bin/
obj/

# Release / publish output. Carries a full copy of appsettings.Production.json,
# so committing it leaks the database password and the JWT signing key.
publish-out/
publish/
[Pp]ublish[Oo]utput/
*.zip

# Web Deploy profiles - these hold the msdeploy username and password in plain
# XML, which is push access to the live site.
*.publishSettings
*.pubxml
*.pubxml.user
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
TestResults/

# Local secrets (use `dotnet user-secrets` instead of committing these)
appsettings.*.local.json
secrets.json

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Environment files (.env.example IS committed)
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
